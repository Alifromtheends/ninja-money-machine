{
  "manifest_version": 3,
  "name": "TL;DR — 3 Bullet Summary",
  "version": "1.0.0",
  "description": "Summarize any webpage into 3 clear bullet points. Runs entirely offline.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Summarize this page"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
